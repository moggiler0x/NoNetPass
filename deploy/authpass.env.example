# Драйвер: mikrotik | mikrotik-api | keenetic | openwrt | opnsense | nftables | ipset | mock
AUTHPASS_DRIVER=mikrotik
AUTHPASS_ROUTER_URL=https://192.168.88.1
AUTHPASS_ROUTER_USER=authpass
AUTHPASS_ROUTER_PASSWORD=CHANGE_ME
AUTHPASS_ROUTER_VERIFY_TLS=true
AUTHPASS_CLIENT_LIST=authpass-clients

AUTHPASS_WINDOW_SECONDS=60
AUTHPASS_GATEWAY_HOSTS=id.vk.com
AUTHPASS_TARGET_HOSTS=im.vk.com,api.vk.com

# Токены для детекции (DNS/прокси/агент) и админского API
AUTHPASS_DETECT_TOKEN=
AUTHPASS_ADMIN_TOKEN=

AUTHPASS_LOG_PATH=/var/lib/authpass/sessions.jsonl
# AUTHPASS_DNS_LOG_PATH=/var/log/dnsmasq.log
