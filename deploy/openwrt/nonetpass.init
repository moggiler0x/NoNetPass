#!/bin/sh /etc/rc.common
# /etc/init.d/nonetpass — запуск NoNetPass на самом OpenWrt (драйвер nftables).

START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 -m nonetpass --port 8080
	procd_set_param env \
		NONETPASS_DRIVER=nftables \
		NONETPASS_LOG_PATH=/var/log/nonetpass-sessions.jsonl \
		NONETPASS_DNS_LOG_PATH=/var/log/dnsmasq.log
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
