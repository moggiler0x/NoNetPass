# Добавить в /etc/config/firewall, затем: fw4 reload
config include 'nonetpass_sets'
	option type 'nftables'
	option path '/etc/nonetpass/sets.nft'
	option position 'table-pre'

config include 'nonetpass_rule'
	option type 'nftables'
	option path '/etc/nonetpass/rule.nft'
	option position 'chain-pre'
	option chain 'forward_lan'
