#!/bin/sh /etc/rc.common
# /etc/init.d/authpass — запуск AuthPass на самом OpenWrt (драйвер nftables).

START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 -m authpass --port 8080
	procd_set_param env \
		AUTHPASS_DRIVER=nftables \
		AUTHPASS_LOG_PATH=/var/log/authpass-sessions.jsonl \
		AUTHPASS_DNS_LOG_PATH=/var/log/dnsmasq.log
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
