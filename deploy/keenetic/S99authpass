#!/bin/sh
# /opt/etc/init.d/S99authpass — AuthPass на Keenetic (Entware).

ENABLED=yes
PROCS=python3
ARGS="-m authpass --port 8080"
PREARGS=""
DESC="AuthPass"
PATH=/opt/sbin:/opt/bin:/opt/usr/sbin:/opt/usr/bin:/usr/sbin:/usr/bin:/sbin:/bin

export AUTHPASS_DRIVER=ipset
export AUTHPASS_LOG_PATH=/opt/var/log/authpass-sessions.jsonl

. /opt/etc/init.d/rc.func
