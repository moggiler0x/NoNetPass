# NoNetPass: настройки только через окружение. Секреты (пароли, токены,
# chat_id) держите в этом файле на сервере, в репозиторий его не кладите.

# --- Роутер, который открывает окна ---------------------------------------
# Драйвер: mikrotik | mikrotik-api | keenetic | openwrt | opnsense | nftables | ipset | mock
NONETPASS_DRIVER=mikrotik
NONETPASS_ROUTER_NAME=mikrotik
NONETPASS_ROUTER_URL=https://192.168.88.1
NONETPASS_ROUTER_USER=nonetpass
NONETPASS_ROUTER_PASSWORD=CHANGE_ME
NONETPASS_ROUTER_VERIFY_TLS=true
NONETPASS_CLIENT_LIST=nonetpass-clients

# --- Дополнительные роутеры: мониторинг и перезагрузка из бота -------------
# NONETPASS_ROUTERS=keenetic
# NONETPASS_ROUTER_KEENETIC_DRIVER=keenetic
# NONETPASS_ROUTER_KEENETIC_URL=http://192.168.1.1
# NONETPASS_ROUTER_KEENETIC_USER=admin
# NONETPASS_ROUTER_KEENETIC_PASSWORD=CHANGE_ME

# --- Окна и ограничения -----------------------------------------------------
NONETPASS_VERIFY_WINDOW_SECONDS=120
NONETPASS_PAY_WINDOW_SECONDS=300
NONETPASS_EXTEND_SECONDS=60
NONETPASS_MAX_EXTENDS=1
NONETPASS_COOLDOWN_SECONDS=15
NONETPASS_MAX_OPENS_PER_HOUR=6
# Чёрный список, который нельзя снять из панели (через запятую)
# NONETPASS_BLOCKED_MACS=
# NONETPASS_BLOCKED_IPS=
# NONETPASS_GATES_FILE=/etc/nonetpass/gates.json

# --- Админ-панель (/admin) --------------------------------------------------
NONETPASS_ADMIN_PIN=
# NONETPASS_ADMIN_USER=admin
# NONETPASS_ADMIN_PASSWORD=
# Ключ подписи cookie панели (иначе после перезапуска нужно войти заново)
NONETPASS_SECRET=
# Подсети, откуда открыта панель, например только сеть администратора
# NONETPASS_ADMIN_NETWORKS=192.168.88.0/24
NONETPASS_ADMIN_TOKEN=
NONETPASS_DETECT_TOKEN=

# --- Telegram-бот администратора --------------------------------------------
# Токен от @BotFather и chat_id администраторов через запятую.
# chat_id бот сам покажет в ответ на любое сообщение.
NONETPASS_TELEGRAM_TOKEN=
NONETPASS_TELEGRAM_ADMIN_IDS=
# NONETPASS_TELEGRAM_PROXY=socks5://user:pass@proxy:1080

# --- Мониторинг и отчёты ----------------------------------------------------
NONETPASS_HEALTH_INTERVAL_SECONDS=30
NONETPASS_HEALTH_FAIL_AFTER=2
NONETPASS_TIMEZONE=Europe/Moscow
NONETPASS_REPORT_DAY=1
NONETPASS_REPORT_HOUR=9
# NONETPASS_METRICS_TOKEN=

# --- Перезагрузка -----------------------------------------------------------
NONETPASS_ALLOW_RESTART=true
# Команда перезагрузки сервера NoNetPass (пусто: выключено)
# NONETPASS_HOST_REBOOT_CMD=sudo /usr/bin/systemctl reboot
NONETPASS_REBOOT_COOLDOWN_SECONDS=300

# --- Детекция ---------------------------------------------------------------
# NONETPASS_DNS_LOG_PATH=/var/log/dnsmasq.log
# Syslog роутера (DNS-запросы): порт и адреса роутеров
# NONETPASS_SYSLOG_PORT=5514
# NONETPASS_SYSLOG_ALLOW=192.168.88.1
